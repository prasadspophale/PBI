table 'All Analysis with AI Final'
	lineageTag: 120d8f58-c573-4745-88ad-5d610f69b93c

	measure 'Stocks Scanned' = DISTINCTCOUNT('All Analysis with AI Final'[stock])
		formatString: 0
		lineageTag: 8f2f5fd4-8d57-4b53-9a60-42d6484cf001

	measure 'Buy Signals' = CALCULATE(DISTINCTCOUNT('All Analysis with AI Final'[stock]), 'All Analysis with AI Final'[long_term_signal] = "BUY")
		formatString: 0
		lineageTag: 8f2f5fd4-8d57-4b53-9a60-42d6484cf002

	measure 'Sell Signals' = CALCULATE(DISTINCTCOUNT('All Analysis with AI Final'[stock]), 'All Analysis with AI Final'[long_term_signal] = "SELL")
		formatString: 0
		lineageTag: 8f2f5fd4-8d57-4b53-9a60-42d6484cf003

	measure 'Hold Signals' = CALCULATE(DISTINCTCOUNT('All Analysis with AI Final'[stock]), 'All Analysis with AI Final'[long_term_signal] = "HOLD")
		formatString: 0
		lineageTag: 8f2f5fd4-8d57-4b53-9a60-42d6484cf004

	measure 'Average Confidence' = DIVIDE(AVERAGE('All Analysis with AI Final'[confidence]), 100)
		formatString: 0.0%
		lineageTag: 8f2f5fd4-8d57-4b53-9a60-42d6484cf005

	measure 'Average Confidence Score' = AVERAGE('All Analysis with AI Final'[confidence])
